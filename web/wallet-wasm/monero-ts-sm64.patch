diff --git a/webpack.lib.js b/webpack.lib.js
new file mode 100644
index 00000000..c3b4100c
--- /dev/null
+++ b/webpack.lib.js
@@ -0,0 +1,17 @@
+"use strict"
+// SM64COIN: the main-thread API (index.ts) as one ES module, loaded by the web app at runtime
+// next to monero.worker.js (the worker holds the wasm).
+const path = require("path");
+const configBase = require("./webpack.base.js");
+
+module.exports = Object.assign({}, configBase, {
+  name: "Monero lib config",
+  entry: "./index.ts",
+  externals: [], // node-only modules (child_process, ws ...) become empty modules, never loaded in a browser
+  experiments: { outputModule: true },
+  output: { path: path.resolve(__dirname, "dist"), filename: "monero-ts.lib.mjs", library: { type: "module" } },
+  resolve: Object.assign({}, configBase.resolve, {
+    fallback: Object.assign({}, configBase.resolve.fallback, { child_process: false, worker_threads: false, ws: false, perf_hooks: false, "web-worker": false }),
+    alias: Object.assign({}, configBase.resolve.alias, { "#monero-ts/monero.js": path.resolve(__dirname, "stubs/no-wasm.js") }),
+  }),
+});
