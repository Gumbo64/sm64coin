{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app window: its own commands and event listening, nothing else (no fs, shell, http plugins; the file dialog is opened by Rust).",
  "windows": ["main"],
  "permissions": [
    "allow-host-info", "allow-rom-set", "allow-rom-pick", "allow-rom-bytes", "allow-node-start", "allow-node-stop", "allow-node-status", "allow-node-rpc", "allow-remote-rpc",
    "allow-miner-start", "allow-miner-stop", "allow-miner-status",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
