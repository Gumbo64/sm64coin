{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The desktop app window: its own commands and event listening, nothing else (no fs, shell, http plugins; the file dialog is opened by Rust).",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-host-info", "allow-rom-set", "allow-rom-pick", "allow-rom-bytes", "allow-node-start", "allow-node-stop", "allow-node-status", "allow-node-settings", "allow-node-settings-set", "allow-node-port-detect", "allow-node-log", "allow-node-rpc", "allow-remote-rpc", "allow-remote-node-get", "allow-remote-node-set",
    "allow-miner-start", "allow-miner-stop", "allow-miner-status", "allow-miner-viz-on", "allow-miner-viz-mail",
    "allow-wallet-state", "allow-wallet-rpc", "allow-wallet-settings", "allow-wallet-activity", "allow-wallet-pin-enable", "allow-wallet-pin-open", "allow-wallet-pin-disable", "allow-link-start", "allow-link-status", "allow-link-cancel", "allow-link-finish",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
