{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SM64Coin",
  "version": "0.5.0",
  "identifier": "io.github.gumbo64.sm64coin",
  "build": {
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "SM64Coin", "width": 1280, "height": 860, "minWidth": 800, "minHeight": 600 }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
