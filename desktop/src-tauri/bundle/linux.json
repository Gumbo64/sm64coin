{
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Game",
    "shortDescription": "SM64Coin: mine blocks by playing Super Mario 64",
    "longDescription": "SM64Coin desktop app: the website with a local node, a native miner and a wallet. You bring your own US Super Mario 64 ROM.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "externalBin": ["stage/binaries/sm64coind", "stage/binaries/sm64coin-wallet-rpc", "stage/binaries/sm64coin-automine", "stage/binaries/rrtrun"],
    "resources": { "stage/res/seeds.txt": "seeds.txt", "stage/res/routes/*": "routes/" },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"], "files": { "/usr/bin/lib": "stage/lib" } },
      "appimage": { "files": { "/usr/bin/lib": "stage/lib" } }
    }
  }
}
